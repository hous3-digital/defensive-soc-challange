# Replaces the base image default.conf: plain HTTP only (TLS terminates
# upstream), real client IP taken from X-Forwarded-For of trusted peers.

server_tokens ${SERVER_TOKENS};
more_set_headers 'Server: ${SERVER_HEADER}';

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Append the trusted peer to the chain instead of the (already rewritten)
# client address, so the backend receives the original chain + our hop.
map $http_x_forwarded_for $soc_forwarded_for {
    ''      $realip_remote_addr;
    default "$http_x_forwarded_for, $realip_remote_addr";
}

map $http_x_forwarded_proto $soc_forwarded_proto {
    ''      $scheme;
    default $http_x_forwarded_proto;
}

server {
    listen ${PORT} default_server;
    server_name _;

    include includes/real_ip.conf;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    modsecurity_transaction_id "$request_id";

    location = /healthz {
        access_log off;
        modsecurity off;
        default_type text/plain;
        return 200 "OK\n";
    }

    location / {
        client_max_body_size ${CLIENT_MAX_BODY_SIZE};

        # Host must match the upstream (Render/Cloudflare reject a wrong Host).
        proxy_set_header Host ${PROXY_HOST_HEADER};
        proxy_set_header Proxy "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $soc_forwarded_for;
        proxy_set_header X-Forwarded-Proto $soc_forwarded_proto;
        proxy_set_header X-Request-ID $request_id;

        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout ${PROXY_TIMEOUT};
        proxy_send_timeout ${PROXY_TIMEOUT};
        proxy_redirect off;

        # Needed when BACKEND is https:// (SNI for Cloudflare/Render).
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;

        proxy_pass ${BACKEND};
    }
}
